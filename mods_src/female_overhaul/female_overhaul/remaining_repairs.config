  "/objects/plushies/community/edition6/starridernovaplush/PBstarridernova.object": [
    {
      "source": "Armok_Fixes_5.4_compat.pak",
      "old": "/objects/plushies/community/edition6/starridernovaplush/PBstarridernovaplush.object",
      "target": "/objects/plushies/community/edition6/starridernovaplush/PBstarridernova.object",
      "kind": "ops",
      "operations": [
        {
          "op": "replace",
          "path": "/description",
          "value": "한때 두려움의 대상이었던 노바키드 도적으로, 먼 행성에서 벌인 그녀의 불가능해 보이는 업적과 강도 행각에 관한 이야기가 많이 전해집니다."
        },
        {
          "op": "replace",
          "path": "/apexDescription",
          "value": "Was she really feared? The hat makes her look kind of cute."
        },
        {
          "op": "replace",
          "path": "/avianDescription",
          "value": "I know it's a plushie of a criminal, but why does it look adorable?"
        },
        {
          "op": "replace",
          "path": "/floranDescription",
          "value": "Real novakid desspicable. Plussh novakid appreciable!"
        },
        {
          "op": "replace",
          "path": "/glitchDescription",
          "value": "Conflicted. I want to hug this plush but I feel I shouldn't."
        },
        {
          "op": "replace",
          "path": "/humanDescription",
          "value": "I've never heard of her, was she as despicable as the stories say?"
        }
      ]
    }
  ],
  "/objects/plushies/community2/edition10/nimbospriteplush/nimbospriteplush.object": [
