[["/biomes/surface_detached/hellfirefield.biome.patch", "/friendlyName", "인페르노 들판"], ["/cinematics/CHARACTERS/NAZRIN/gic_nazrin_planetencounter_wartorn.cinematic.patch", "/panels/2/text", "알겠습니다, 셸.\n\n당신은 전란 세계의 불타는 모래를 걷습니다. 광신자와 겁 없는 자가 아직 주인 없는 부를 두고 불안정한 나라에서 싸우는 곳입니다.\n\n이 세계의 주민들은 공개 충돌 중이며, 제국적 주장을 거부하는 광신적 토착민에게 독립자 동맹의 인페르노를 퍼붓습니다."], ["/interface/kukagps/biomes.config.patch", "/hellfirefield", "인페르노 들판"], ["/items/MATERIALS/pixelgoods/fuokeamagmabrick.matitem.patch", "/description", "마그마스톤과 인페르노로 만든 벽돌입니다."], ["/items/MATERIALS/pixelgoods/fuokeamagmabrick.matitem.patch", "/shortdescription", "인페르노 벽돌"], ["/items/MATERIALS/pixelgoods/fuokeamagmastone.matitem.patch", "/description", "마그마석과 인페르노로 만든 돌입니다."], ["/items/MATERIALS/pixelgoods/fuokeamagmastone.matitem.patch", "/shortdescription", "인페르노 돌"], ["/items/MEDICAL/gic_burnteffigy.consumable.patch", "/description", "이 희미한 우상에서 부드러운 온기가 뿜어져 나옵니다. 누군가를 표현한 모양인데, 항상 내부에서 인페르노처럼 타고 있는 듯합니다.\n\n^#FD8F4D;근접 무기 공격에 불타는 베기를 추가해 추가 열 피해와 약간의 사거리 증가 | 근접 무기 종류에 비례 | 60초간 지속.^white;"], ["/items/WEAPONS/RANGED/LIGHT_MACHINEGUN/gic_hellfirestubber/gic_npc_undercolony_hellfirestubber.activeitem.patch", "/shortdescription", "인페르노 스터버"], ["/items/WEAPONS/RANGED/REVOLVER/gic_firefly/gic_firefly.activeitem.patch", "/shortdescription", "반딧불 | ^#E2006D;''혼돈, 인페르노, 평온.''"], ["/items/active/arcana_spells/fire/firePillars/firePillars.activeitem.patch", "/primaryAbility/name", "인페르노 폭발"], ["/items/active/arcana_spells/fire/hellfireBlast/hellfireBlast.activeitem.patch", "/primaryAbility/name", "인페르노 폭발"], ["/items/active/shields/hellfireshield.activeitem.patch", "/shortdescription", "인페르노 방패"], ["/items/active/weapons/bow/hellfirebow/hellfirebow.activeitem.patch", "/shortdescription", "인페르노 활"], ["/items/active/weapons/melee/broadsword/hellfireblade.activeitem.patch", "/shortdescription", "인페르노 칼날"], ["/items/active/weapons/melee/mace/hellfiremace.activeitem.patch", "/shortdescription", "인페르노 메이스"], ["/items/active/weapons/melee/rapier/hellfirerapier.activeitem.patch", "/shortdescription", "인페르노 레이피어"], ["/items/active/weapons/melee/spear/hellfirespear.activeitem.patch", "/shortdescription", "인페르노 창"], ["/items/active/weapons/other/magnorbs/magnorbhellfire/magnorbhellfire.activeitem.patch", "/shortdescription", "인페르노 오브"], ["/items/active/weapons/ranged/unique/hellfirecannon.activeitem.patch", "/shortdescription", "인페르노 이젝터"], ["/items/active/weapons/ranged/unique/hellfiregun.activeitem.patch", "/shortdescription", "인페르노 총"], ["/items/active/weapons/ranged/unrand/s12neo_flamer/s12neo_flamethrower.activeitem.patch", "/description", "타라, 타라. 디스코 인페르노."], ["/items/active/weapons/ranged/unrand/s12neo_flamer/s12neo_npcflamethrower.activeitem.patch", "/description", "타라, 타라. 디스코 인페르노."], ["/items/armors/tier5/hellfire/hellfire.chest.patch", "/shortdescription", "인페르노 갑옷"], ["/items/upgrade chips/affinity/ivrpgucbloom.activeitem.patch", "/description", "화염 & 인페르노 친화력 업그레이드.\n불타는 적을 처치하면 폭발한다."], ["/items/upgrade chips/affinity/ivrpguceternalflame.activeitem.patch", "/description", "화염 & 인페르노 친화력 업그레이드.\n모든 친화력 약점을 무효화한다."], ["/items/upgrade chips/affinity/ivrpgucvikingfuneral.activeitem.patch", "/description", "화염 & 인페르노 친화력 업그레이드.\n그을림 지속 시간이 두 배가 된다."], ["/ivrpgtext.config.patch", "/upgrades/affinity/ivrpguceternalflame/description", "화염 & 인페르노 친화력 업그레이드.\n친화력 약점이 더 이상 영향을 주지 않는다."], ["/ivrpgtext.config.patch", "/upgrades/affinity/ivrpgucbloom/description", "화염 & 인페르노 친화력 업그레이드.\n화상, 용해, 또는 그을림 상태의 적을 처치하면 폭발한다.\n폭발 피해는 위력 배율에 비례해 증가한다."], ["/ivrpgtext.config.patch", "/upgrades/affinity/ivrpgucvikingfuneral/description", "화염 & 인페르노 친화력 업그레이드.\n그을림 지속 시간이 두 배가 된다."], ["/npcs/ttpp_quests/ttpp_mission1/ttppclownboss.npctype.patch", "/scriptConfig/dialog/attack/default/default/0", "고리 통과하게 해줄게... 인페르노 고리!"], ["/npcs/ttpp_quests/ttpp_mission1/ttppclownboss.npctype.patch", "/scriptConfig/dialog/attack/human/default/0", "고리 통과하게 해줄게... 인페르노 고리!"], ["/objects/FARMABLES/hellfireplantseed/hellfireplantseed.object.patch", "/description", "던지면 치명적인 인페르노 결절을 사용하여 무기를 만들 수도 있습니다."], ["/objects/FARMABLES/hellfireplantseed/hellfireplantseed.object.patch", "/shortdescription", "인페르노 식물 씨앗"], ["/objects/FARMABLES/hellfireplantseed/wildhellfireplantseed.object.patch", "/description", "던지면 치명적인 인페르노 결절을 사용하여 무기를 만들 수도 있습니다."], ["/objects/FARMABLES/hellfireplantseed/wildhellfireplantseed.object.patch", "/shortdescription", "인페르노 식물 씨앗"], ["/objects/atprk_relicseeker/atprk_planetpins/atprk_extendedfirepin.object.patch", "/description", "타오르는 인페르노 행성의 커다란 핀 배지입니다."], ["/objects/atprk_relicseeker/atprk_planetpins/atprk_extendedfirepin.object.patch", "/shortdescription", "타오르는 인페르노 핀"], ["/objects/atprk_relicseeker/atprk_planetpins/atprk_extendedfirepin.object.patch", "/novakidDescription", "타오르는 인페르노 행성이구만. 절대 안 꺼지는구만. 아니, 공기까지 타고 있다니까!"], ["/objects/microformer/hellfirefield/microformerhellfirefield.object.patch", "/description", "행성 지역을 인페르노로 변화시킵니다."], ["/objects/microformer/hellfirefield/microformerhellfirefield.object.patch", "/shortdescription", "인페르노 마이크로포머"], ["/objects/minibiome/hellfire/hellfirechest1.object.patch", "/shortdescription", "인페르노 상자"], ["/objects/minibiome/hellfire/hellfirechest2.object.patch", "/shortdescription", "인페르노 상자"], ["/objects/terraformer/v-terraformerministar.object.patch", "/description", "행성의 기후를 태양 인페르노로 변환합니다."], ["/tiles/materials/pixelgoods/fuokeamagmabrick.material.patch", "/description", "마그마스톤과 인페르노로 만든 벽돌입니다."], ["/tiles/materials/pixelgoods/fuokeamagmabrick.material.patch", "/shortdescription", "인페르노 벽돌"], ["/tiles/materials/pixelgoods/fuokeamagmastone.material.patch", "/description", "마그마석과 인페르노로 만든 돌입니다."], ["/tiles/materials/pixelgoods/fuokeamagmastone.material.patch", "/shortdescription", "인페르노 돌"]]